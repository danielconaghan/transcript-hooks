# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime data lives in ~/.claude-resync/data, never here — fires.jsonl
# carries fragments of prompts (paths and URLs lifted from whatever message
# fired a rule), so it is as secrets-bearing as the corpus. This entry is a
# net in case anything is ever written locally by mistake.
data/

# The corpus and refined archive live in ~/.claude-resync, never in this repo.
# Belt-and-braces: those dirs also self-ignore with a .gitignore of '*'.
.claude-resync/
.claude-transcripts/
corpus/
refined/

# API credentials for the drafted fixes. Lives in ~/.claude-resync/.env;
# this entry is a net in case one is ever created here by mistake.
.env
.DS_Store

# Per-machine Claude Code permissions. Accumulates absolute paths from whatever
# session granted a rule (scratchpad dirs, one-off script paths), so it is
# noise in a shared history. settings.json beside it IS tracked — it registers
# the hooks and belongs to the project.
.claude/settings.local.json
